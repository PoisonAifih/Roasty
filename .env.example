POSTGRES_USER=roasty
POSTGRES_PASSWORD=roasty
POSTGRES_DB=roasty
POSTGRES_PORT=5433
DATABASE_URL=postgres://roasty:roasty@127.0.0.1:5433/roasty?sslmode=disable
ADDR=:8014
OPENROUTER_API_KEY=sk-or-v1-your-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=deepseek/deepseek-v4-flash
VITE_API_URL=http://localhost:8014

# Qdrant (RAG). Ports are host-side; inside the compose network use http://qdrant:6333
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=coffee_knowledge
# Embedding model used to index the corpus. Must match at index and query time -
# changing it means re-indexing everything.
EMBEDDING_MODEL=
